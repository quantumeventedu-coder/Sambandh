{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/home.html"
    },
    {
      "src": "/app",
      "dest": "/public/index.html"
    },
    {
      "src": "/(health|api/.*|socket\\.io/.*|uploads/.*|u/.*|sitemap\\.xml|robots\\.txt|\\.well-known/.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/intelligence/jobs/drain?maintenance=1",
      "schedule": "30 20 * * *"
    }
  ]
}
