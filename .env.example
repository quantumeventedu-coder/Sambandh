# Sambandh — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# Values marked (dev) can stay as-is for local development.

# ---- Server ----
NODE_ENV=development
PORT=3010
FRONTEND_URL=
# Comma-separated list of origins allowed to call the API cross-origin.
# The web app is served same-origin so it never needs this. If left blank,
# cross-origin is reflected in development and denied in production.
CORS_ORIGINS=

# ---- Database ----
# MongoDB Atlas connection string from cloud.mongodb.com.
# If unreachable, the server auto-starts an in-memory dev DB (data resets on restart).
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sambandh?retryWrites=true

# ---- JWT ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_hex_chars

# ---- Local development flags (REMOVE ALL of these before public launch) ----
DEV_MODE=true            # (dev) OTP shown on screen instead of real SMS
DEV_PAYMENTS=true        # (dev) payments simulated instead of live gateway
SEED_DEMO=true           # (dev) seeds demo users when the DB is empty
ADMIN_API_KEY=              # moderator panel key — generate a long random value (never commit a real one)
SUPER_ADMIN_KEY=            # owner-only key (audited chat access) — generate a long random value; boot REFUSES known-public keys

# ---- Payments (Razorpay) — ALL PRICES ARE IN CHF ----
# Join fee: men CHF 1 · women CHF 5 · non-binary CHF 3 (one-time, no free tier)
# Sambandh+ CHF 6/mo · Premium CHF 15/mo · escalations CHF 0.50–1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Karma Book AI (Anthropic) ----
ANTHROPIC_API_KEY=

# ---- SMS OTP (Firebase) — setting FIREBASE_PROJECT_ID enables production login ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---- ID verification providers (automated engine; simulated in dev mode) ----
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
HYPERVERGE_APP_ID=
KARZA_API_KEY=

# ---- Photo/document storage (Supabase Storage; local ./uploads if empty) ----
# Consolidated onto Supabase. From your Supabase project → Settings → API:
#   SUPABASE_URL        = the Project URL (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_KEY= the service_role key (server-side only, keep secret)
# A public bucket named by SUPABASE_BUCKET is auto-created on first upload.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sambandh

# ---- Astrology (ProKerala) — internal approximation used if empty ----
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=

# ---- NSFW image moderation ----
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# ---- Monitoring ----
SENTRY_DSN=

# ---- Email delivery (OTP + transactional). Unset = dev transport (logs to console). ----
# Either a full SMTP URL, or discrete host/port/user/pass. EMAIL_FROM sets the sender.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Sambandh <no-reply@sambandh.app>

# ---- Web push (browser notifications). Unset = ephemeral dev keys (work locally). ----
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sambandh.app

# ---- Google account login (optional). Get a client id from console.cloud.google.com. ----
GOOGLE_CLIENT_ID=


# ---------------------------------------------------------------------------
# Sambandh Setu Intelligence Engine (src/intelligence) — all optional.
# With nothing set, Setu Guide runs in "basic mode" on CPU (Setu Core).
# ---------------------------------------------------------------------------
# Self-hosted model (OpenAI-compatible: vLLM / llama.cpp server / LM Studio / TGI,
# or SETU_LLM_PROVIDER=ollama for Ollama's native API):
SETU_LLM_PROVIDER=openai
SETU_LLM_BASE_URL=            # e.g. https://gpu.your-domain:8000/v1  or  http://127.0.0.1:11434
SETU_LLM_MODEL=               # e.g. qwen2.5-14b-instruct-awq  or  qwen2.5:3b
SETU_LLM_API_KEY=             # if your inference server requires a bearer token
SETU_LLM_TOOLS=true           # model supports tool calling
SETU_LLM_SMALL_MODEL=         # optional fast model for extraction/classification
SETU_EMBED_MODEL=             # e.g. bge-m3 or nomic-embed-text (same server unless SETU_EMBED_BASE_URL)
SETU_EMBED_BASE_URL=
# SETU_MODELS='[{"modelKey":"gpu-a","provider":"openai","baseUrl":"...","model":"...","tasks":["chat"],"priority":5}]'
SETU_ALLOW_EXTERNAL=false     # true = allow ANTHROPIC_API_KEY as an optional, lower-priority fallback

# Web research (self-hosted SearXNG preferred; JSON output must be enabled in settings.yml)
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=         # optional alternative

# Encryption key for memories / Setu Guide conversations (64 hex chars). If unset,
# a key is derived from JWT_SECRET. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMORY_KEY=

# Vercel Cron → GET /api/intelligence/jobs/drain sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ---------------------------------------------------------------------------
# Public profiles, app links, push (Sambandh Setu)
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=https://www.sambandh.online
ANDROID_PACKAGE=com.sambandh.app
ANDROID_CERT_SHA256=          # release signing-key SHA-256, comma-separated
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.sambandh.app
FCM_SERVICE_ACCOUNT_JSON=     # Firebase service account JSON (one line) for Android/iOS push
MIN_ANDROID_VERSION=1.0.0
MIN_IOS_VERSION=1.0.0
